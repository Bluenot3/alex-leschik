# ─────────────────────────────────────────────────────────────
# Set these in Vercel: Project → Settings → Environment Variables
# (Production, Preview, and Development). None of them are exposed
# to the browser — they are only read inside /api functions.
# ─────────────────────────────────────────────────────────────

# ── Owner access ─────────────────────────────────────────────
# The studio PIN, checked server-side.
OWNER_PIN=317593
# Any long random string; signs the session cookie.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# ── Notion ───────────────────────────────────────────────────
# Create at notion.so/my-integrations, then share each database
# below with that integration (••• → Connections → your integration).
NOTION_TOKEN=
NOTION_LEADS_DB=27217d1713b24f2abd4ac5cb092ea189
NOTION_NEWSLETTER_DB=4cf99fe34d714fc891900349d1474918
NOTION_ZENGEN_DB=db463a1be65b4bc18aced25ba08be13f

# ── Cloudflare R2 ────────────────────────────────────────────
# R2 → Manage API tokens → Create (Object Read & Write on the bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zen-gen
# The bucket's public URL — either the r2.dev dev domain or a custom
# domain. Must be public-read so the gallery can display images.
R2_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev
