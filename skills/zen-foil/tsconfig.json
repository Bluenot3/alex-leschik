{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["@webgpu/types"],
    "jsx": "react-jsx",
    "paths": { "zen-foil": ["./src/index.ts"] }
  },
  "include": ["src"]
}
